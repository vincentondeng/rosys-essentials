---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container not-found">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">The link may be out of date, or the page may have moved. These pages might help:</p>
      <ul class="ticks">
        <li><a href={url('/packages/')}>Compare our dignity kit packages</a></li>
        <li><a href={url('/how-it-works/')}>See how ordering works</a></li>
        <li><a href={url('/quote/')}>Request a quote</a></li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--primary" href={url('/')}>Go to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    padding-block: 2rem;
  }

  .not-found .ticks {
    margin-bottom: 2rem;
  }
</style>
