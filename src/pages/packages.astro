---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCompare from '../components/PackageCompare.astro';
import DeliveryBanner from '../components/DeliveryBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import packages from '../data/packages.json';

const { items, tiers, custom } = packages;
---

<BaseLayout
  title="Dignity Kit Packages for NGOs & Schools"
  description="Compare our Basic, Essential and Premium dignity kits for NGOs, or request a custom kit. Sold in bulk with volume pricing, delivered anywhere in Kenya."
>
  <section class="page-head">
    <div class="container page-head__inner">
      <h1>Choose the kit that fits your program</h1>
      <div class="page-head__side">
        <p class="lead">
          Three ready-made dignity kits, sold in bulk with volume-based pricing, or a custom kit built around your
          program. Every order is delivered anywhere in Kenya.
        </p>
        <nav class="jump" aria-label="Jump to a package">
          <ol>
            {tiers.map((tier, i) => (
              <li><a href={`#${tier.id}`}><span class="label" aria-hidden="true">0{i + 1}</span>{tier.name}</a></li>
            ))}
            <li><a href="#custom"><span class="label" aria-hidden="true">0{tiers.length + 1}</span>{custom.name}</a></li>
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section section--compare" aria-labelledby="compare-title">
    <div class="container">
      <h2 id="compare-title">Compare the kits</h2>
      <PackageCompare />
      <p class="note">
        Prices depend on the package, quantity and delivery location. <a href={url('/quote/')}>Request a quote</a> and we'll
        send a tailored price for your order.
      </p>
    </div>
  </section>

  <!-- Detail per tier: alternating wide feature rows -->
  {tiers.map((tier, i) => (
    <section id={tier.id} class:list={['tier', { 'section--parchment': i % 2 === 0 }]} aria-labelledby={`${tier.id}-title`}>
      <div class:list={['container', 'tier__inner', { 'tier__inner--flip': i % 2 === 1 }]}>
        <figure class="plate tier__plate">
          <div class="plate__img">
            <img src={url(tier.image)} alt={tier.imageAlt} width="480" height="600" loading="lazy" decoding="async" />
          </div>
          <figcaption>
            <span class="label">Plate 0{i + 1}</span>
            <span class="label">{tier.contents.packaging}</span>
          </figcaption>
        </figure>

        <div class="tier__copy">
          <h2 id={`${tier.id}-title`}>{tier.name} kit</h2>
          {tier.popular && <p class="tier__tag label">Most popular</p>}
          <p class="tier__best">Best for <strong>{tier.bestFor.toLowerCase()}</strong></p>
          <p class="tier__summary">{tier.summary}</p>

          <h3 class="tier__subhead label">What's inside</h3>
          <dl class="tier__list">
            {items.map((item) => {
              const value = tier.contents[item.key as keyof typeof tier.contents];
              return (
                <div class:list={{ 'tier__excluded': !value }}>
                  <dt>{item.label}</dt>
                  <dd>{value ?? 'Not included'}</dd>
                </div>
              );
            })}
          </dl>

          <dl class="ledger tier__facts">
            <div><dt>Minimum order</dt><dd>{tier.minOrder}</dd></div>
            <div><dt>Delivery</dt><dd>Anywhere in Kenya</dd></div>
          </dl>

          <a class="btn btn--primary" href={url(`/quote/?package=${tier.id}`)}>
            Request a Quote<span class="visually-hidden"> for the {tier.name} kit</span>
            <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- Custom -->
  <section id="custom" class:list={['tier', { 'section--parchment': tiers.length % 2 === 0 }]} aria-labelledby="custom-title">
    <div class:list={['container', 'tier__inner', { 'tier__inner--flip': tiers.length % 2 === 1 }]}>
      <figure class="plate tier__plate">
        <div class="plate__img">
          <img src={url(custom.image)} alt={custom.imageAlt} width="480" height="600" loading="lazy" decoding="async" />
        </div>
        <figcaption>
          <span class="label">Plate 0{tiers.length + 1}</span>
          <span class="label">Built to order</span>
        </figcaption>
      </figure>
      <div class="tier__copy">
        <h2 id="custom-title">{custom.name}</h2>
        <p class="tier__summary tier__summary--lead">{custom.summary}</p>
        <ul class="tier__points">
          {custom.points.map((point) => <li>{point}</li>)}
        </ul>
        <p class="tier__summary">Tell us about your program, the people you serve and your budget, and we'll propose a kit to match.</p>
        <a class="btn btn--primary" href={url('/quote/?package=custom')}>
          Request a Custom Kit
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </a>
      </div>
    </div>
  </section>

  <DeliveryBanner />

  <CtaBand title="Not sure which kit is right?" text="Tell us about your program and we'll recommend a package, or build a custom kit around your needs." />
</BaseLayout>

<style>
  /* Jump links: a small table of contents */
  .jump ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
  }

  .jump li {
    border-bottom: 1px solid var(--hairline);
  }

  .jump li:nth-child(odd) {
    border-right: 1px solid var(--hairline);
  }

  .jump a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    gap: 0.25rem;
    min-height: 48px;
    padding: 0.75rem 0.75rem 0.75rem 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .jump li:nth-child(even) a {
    padding-left: 0.75rem;
  }

  .jump a:hover {
    color: var(--rosehip);
  }

  .section--compare h2 {
    margin-bottom: 1.5rem;
  }

  .note {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .tier {
    padding-block: var(--space-section);
    border-top: 1px solid var(--hairline);
  }

  .tier__inner {
    display: grid;
    gap: 2.5rem;
  }

  .tier__inner > * {
    min-width: 0;
  }

  .tier__plate img {
    aspect-ratio: 4 / 5;
  }

  .tier__tag {
    display: inline-block;
    margin: -0.25rem 0 1.25rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--rosehip);
    color: var(--rosehip);
  }

  .tier__copy h2 {
    font-size: var(--step-h1);
    line-height: var(--display-leading);
    letter-spacing: var(--display-track);
    margin-bottom: 1.25rem;
  }

  .tier__best {
    margin-bottom: 0.5rem;
  }

  .tier__summary {
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .tier__summary--lead {
    font-size: 1.2rem;
    color: var(--ink);
  }

  .tier__subhead {
    margin: 2rem 0 0.5rem;
  }

  /* Spec sheet: item on the left in mono, quantity on the right */
  .tier__list {
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--ink);
  }

  .tier__list > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--hairline);
  }

  .tier__list > div > * {
    min-width: 0;
  }

  .tier__list dt {
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .tier__list dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .tier__excluded dd {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .tier__facts {
    margin-bottom: 2rem;
  }

  .tier__points {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .tier__points li {
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--hairline);
  }

  @media (min-width: 640px) {
    .jump ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .jump li {
      border-right: 1px solid var(--hairline);
    }

    .jump li:last-child {
      border-right: 0;
    }

    .jump li:not(:first-child) a {
      padding-left: 0.75rem;
    }
  }

  @media (min-width: 900px) {
    .tier__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: start;
    }

    .tier__inner--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .tier__inner--flip .tier__plate {
      order: 2;
    }

    .tier__plate {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
