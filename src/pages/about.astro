---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const reasons = [
  {
    title: 'Health',
    text: 'Clean pads, fresh underwear and soap help women and girls manage their periods hygienically and lower the risk of infection and discomfort.',
  },
  {
    title: 'Schooling',
    text: 'When a girl has what she needs for her period, she can stay in class with confidence instead of missing lessons each month.',
  },
  {
    title: 'Dignity',
    text: 'Having your own hygiene products, without having to improvise or ask, lets women and girls go about work, school and family life with confidence.',
  },
];

const values = [
  { title: 'Dignity first', text: 'Every kit is something we would be proud to receive ourselves.' },
  { title: 'Reliability', text: 'Programs plan around us, so we deliver what we promise, when we promise it.' },
  { title: 'Quality', text: 'We choose trusted products women already know and use.' },
  { title: 'Partnership', text: 'We work alongside your team, adapting kits to your program and the people you serve.' },
];

// PLACEHOLDER testimonials — replace with real quotes (and permission) from partner organizations before launch.
const testimonials = [
  { quote: 'Testimonial placeholder: replace with a short quote from a partner organization about reliability or quality.', name: 'Name, Role', org: 'Organization, County' },
  { quote: 'Testimonial placeholder: replace with a short quote about the impact of the kits on the women and girls served.', name: 'Name, Role', org: 'Organization, County' },
];
---

<BaseLayout
  title="About Us | Kenyan Dignity Kit Supplier"
  description="Rosy's Essentials is a Kenyan dignity kit supplier helping NGOs and schools give women and girls what they need to manage their periods with dignity."
>
  <section class="page-head">
    <div class="container page-head__inner">
      <h1>Every woman and girl deserves to manage her period with dignity</h1>
      <div class="page-head__side">
        <p class="lead">
          Rosy's Essentials is a Kenyan supplier of ready-packed hygiene and personal care kits for the organizations that
          serve women and girls.
        </p>
      </div>
    </div>
  </section>

  <!-- Story: the founder's own words go here -->
  <section class="section" aria-labelledby="story-title">
    <div class="container story">
      <figure class="plate story__plate">
        <div class="plate__img">
          <img
            src={url('/images/placeholders/about-team.svg')}
            alt="Placeholder: photo of the Rosy's Essentials team packing kits"
            width="480"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span class="placeholder-note">Placeholder: replace with a photo of the team or a packing day.</span>
        </figcaption>
      </figure>
      <div class="story__copy">
        <h2 id="story-title">Our story</h2>
        <!-- PLACEHOLDER story: the owner should rewrite these paragraphs in their own words (who founded Rosy's Essentials, when, and why). -->
        <p class="story__first">
          Rosy's Essentials began with a simple observation: organizations working with women and girls spend a great
          deal of time sourcing, counting and packing hygiene items, time that could be spent with the people they
          serve.
        </p>
        <p>
          So we started putting together complete, ready-to-distribute kits: sanitary pads, underwear, soap and personal
          care items, packed with care and delivered wherever they're needed in Kenya. Today we supply NGOs, schools,
          faith-based groups and community organizations with kits for one-off distributions, monthly programs and
          donor-supported events.
        </p>
        <p class="placeholder-note">Story placeholder: the owner will replace this with the founder's own story.</p>
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="section section--parchment" aria-labelledby="matters-title">
    <div class="container">
      <div class="matters__head">
        <h2 id="matters-title">Menstrual and personal hygiene shape health, schooling and dignity</h2>
        <p class="muted">
          Periods are a normal part of life. Yet for many women and girls, the cost of pads and basic hygiene items means
          making do, and that affects far more than one week a month.
        </p>
      </div>
      <ul class="reasons">
        {reasons.map((reason) => (
          <li class="reason">
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </li>
        ))}
      </ul>
      <p class="matters__close">
        Reliable supply is what turns a one-off donation into lasting change. That's why we focus on getting the right
        kits to your program, on time, every time.
      </p>
    </div>
  </section>

  <!-- Values -->
  <section class="section" aria-labelledby="values-title">
    <div class="container values-wrap">
      <h2 id="values-title">Our values</h2>
      <dl class="values">
        {values.map((value) => (
          <div class="value">
            <dt>{value.title}</dt>
            <dd>{value.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Testimonials (placeholders) -->
  <section class="section section--rule" aria-labelledby="testimonials-title">
    <div class="container">
      <h2 id="testimonials-title" class="testimonials__title">What our partners say</h2>
      <div class="testimonials">
        {testimonials.map((t) => (
          <figure class="testimonial">
            <p class="placeholder-note">Placeholder</p>
            <blockquote>
              <p>“{t.quote}”</p>
            </blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span class="label">{t.org}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Let's support the women and girls you serve" text="Tell us about your program and we'll put together the right kits, delivered anywhere in Kenya." />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: 2.5rem;
  }

  .story > * {
    min-width: 0;
  }

  .story__plate img {
    aspect-ratio: 4 / 5;
  }

  .story__copy {
    max-width: 36rem;
  }

  .story__copy h2 {
    margin-bottom: 1.5rem;
  }

  .story__first {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .story__copy p:not(.story__first):not(.placeholder-note) {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .matters__head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .matters__head h2 {
    margin: 0;
    max-width: 17ch;
  }

  .matters__head p {
    margin: 0;
    max-width: 32rem;
  }

  /* Three reasons ruled into one block with 1px lines */
  .reasons {
    list-style: none;
    margin: 0;
    padding: 1px;
    display: grid;
    gap: 1px;
    background: var(--hairline);
  }

  .reason {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--linen);
  }

  .reason h3 {
    font-size: var(--step-h2);
    margin-bottom: 1.25rem;
  }

  .reason p {
    margin: 0;
    color: var(--ink-soft);
  }

  .matters__close {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .values-wrap {
    display: grid;
    gap: 2rem;
  }

  .values-wrap > * {
    min-width: 0;
  }

  .values {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .value {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .value dt {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .value dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .testimonials__title {
    margin-bottom: 2rem;
  }

  .testimonials {
    display: grid;
    gap: 1rem;
  }

  /* Placeholder quotes: dashed hairline frame so nobody mistakes them for real endorsements */
  .testimonial {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px dashed var(--rule-strong);
  }

  .testimonial blockquote {
    margin: 0.75rem 0 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.2;
  }

  .testimonial blockquote p {
    margin: 0;
  }

  .testimonial figcaption {
    display: grid;
    gap: 0.2rem;
  }

  @media (min-width: 768px) {
    .testimonials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .value {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  @media (min-width: 900px) {
    .story {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: end;
    }

    .matters__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: end;
    }

    .values-wrap {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
  }
</style>
