---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  {
    title: 'Choose a package or request a custom kit',
    text: 'Pick Basic, Essential or Premium, or tell us what your program needs and we’ll design a custom kit with the right items, quantities and branding.',
    link: { href: '/packages/', label: 'Compare packages' },
  },
  {
    title: 'Receive your quote',
    text: 'Send us your package, quantity and delivery location. We reply with a tailored quote based on your order size. Larger orders benefit from volume pricing.',
    link: { href: '/quote/', label: 'Request a quote' },
  },
  {
    title: 'We pack and deliver anywhere in Kenya',
    text: 'Once you approve the quote, we pack every kit and deliver to your office, school or distribution point in any of Kenya’s 47 counties.',
    link: null,
  },
];

const checklist = [
  'Which package you’d like, or what a custom kit should include',
  'Roughly how many kits you need',
  'The county and town for delivery',
  'When you need the kits delivered',
  'Any branding, age group or packing requirements',
];

const faqs = [
  {
    q: 'Do you deliver outside Nairobi?',
    a: 'Yes. We deliver anywhere in Kenya (all 47 counties) to offices, schools, health facilities and community distribution points.',
  },
  {
    q: 'Why don’t you show prices on the website?',
    a: 'Our pricing depends on the package, the number of kits and the delivery location, and larger orders receive volume pricing. A quote lets us give you the best price for your exact order.',
  },
  {
    q: 'Is there a minimum order?',
    a: 'Yes, kits are supplied in bulk. The minimum order for each package is listed on the Packages page, and order sizes are flexible above that. Just tell us what you need.',
  },
  {
    q: 'Can you build a kit to our program’s or donor’s requirements?',
    a: 'Yes. Custom kits can include different items and quantities, suit specific age groups, and carry your organization’s or donor’s branding.',
  },
  {
    q: 'Can we order regularly, for example every month?',
    a: 'Yes. Our Essential kit is designed for monthly programs. Tell us your distribution schedule when you request a quote.',
  },
];
---

<BaseLayout
  title="How Ordering Dignity Kits Works"
  description="Ordering dignity kits from Rosy's Essentials is simple: choose a package or custom kit, receive your quote, and we pack and deliver anywhere in Kenya."
>
  <section class="page-head">
    <div class="container page-head__inner">
      <h1>Three simple steps from request to delivery</h1>
      <div class="page-head__side">
        <p class="lead">
          We handle the sourcing, packing and delivery so your team can focus on the women and girls you serve.
        </p>
      </div>
    </div>
  </section>

  <!-- Steps: the sequence matters, so each step carries its number at display size -->
  <section class="steps-section" aria-label="Ordering steps">
    <div class="container">
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="step">
            <p class="step__num" aria-hidden="true">{i + 1}</p>
            <h2 class="step__title"><span class="visually-hidden">Step {i + 1}: </span>{step.title}</h2>
            <div class="step__body">
              <p>{step.text}</p>
              {step.link && (
                <a class="link-reveal step__link" href={url(step.link.href)}>
                  {step.link.label}
                  <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--parchment" aria-labelledby="checklist-title">
    <div class="container two-col">
      <div>
        <h2 id="checklist-title">What to have ready</h2>
        <p class="muted">
          Don’t worry if you don’t have every detail yet. An estimate is enough to get started, and we’ll confirm the
          rest with you.
        </p>
      </div>
      <ol class="checklist">
        {checklist.map((item, i) => (
          <li><span class="label" aria-hidden="true">{String.fromCharCode(97 + i)}.</span>{item}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container two-col two-col--top">
      <h2 id="faq-title">Frequently asked questions</h2>
      <div class="faq">
        {faqs.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <svg class="faq__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path class="faq__v" d="M8 2v12" /><path d="M2 8h12" /></svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding-block: clamp(2rem, 6vw, 3.5rem);
    border-bottom: 1px solid var(--hairline);
  }

  .step__num {
    grid-row: span 2;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--rosehip);
  }

  .step__title {
    margin: 0 0 0.75rem;
    font-size: var(--step-h2);
    max-width: 18ch;
  }

  .step__body {
    min-width: 0;
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .step__body p {
    margin-bottom: 1rem;
  }

  .step__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--ink);
  }

  .two-col {
    display: grid;
    gap: 2rem;
  }

  .two-col > * {
    min-width: 0;
  }

  .two-col h2 {
    max-width: 12ch;
  }

  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .checklist li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 1.0625rem;
  }

  .checklist .label {
    padding-top: 0.2rem;
  }

  /* FAQ: hairline rows, serif questions, a drawn plus that turns into a minus */
  .faq {
    border-top: 1px solid var(--ink);
  }

  .faq details {
    border-bottom: 1px solid var(--hairline);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary:hover {
    color: var(--rosehip);
  }

  .faq__icon {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .faq__v {
    transition: opacity var(--dur-fast) var(--ease);
  }

  .faq details[open] .faq__v {
    opacity: 0;
  }

  .faq details p {
    margin: 0;
    padding-bottom: 1.5rem;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  @media (min-width: 900px) {
    .step {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
      gap: 3rem;
      align-items: start;
    }

    .step__num {
      grid-row: auto;
    }

    .step__title {
      margin: 0;
      padding-top: 0.5rem;
    }

    .step__body {
      padding-top: 0.75rem;
    }

    .two-col {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }
  }
</style>
