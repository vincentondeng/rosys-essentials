---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCards from '../components/PackageCards.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import DeliveryBanner from '../components/DeliveryBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import Sprig from '../components/Sprig.astro';
import site from '../data/site.json';

// Structured data so search engines understand who we are and where we deliver
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/apple-touch-icon.png'), Astro.site).href,
  description:
    'Kenyan supplier of ready-packed dignity kits (sanitary pads, underwear and personal care items) for NGOs, schools and community organizations.',
  areaServed: { '@type': 'Country', name: 'Kenya' },
  email: site.emailLink,
};

const audiences = ['NGOs', 'Schools', 'Faith-based groups', 'Community-based organizations', 'Women & girls programs'];
---

<BaseLayout
  title="Sanitary Pads & Dignity Kits Supplier in Kenya"
  description="Sanitary pads supplier in Kenya: ready-packed dignity kits for NGOs, schools and community groups. Bulk orders, custom kits, delivery anywhere in Kenya."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />

  <!-- Hero: oversized serif beside a tall framed plate -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <h1>Dignity for every woman and&nbsp;girl, <em class="swash">delivered reliably.<svg class="swash__line" viewBox="0 0 300 14" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 9.5C70 4 160 2.5 296 6.5" /></svg></em></h1>
        <div class="hero__sub">
          <p class="lead">
            We supply ready-packed hygiene and personal care kits to NGOs, schools, faith-based groups and community
            organizations, in the quantities your program needs, delivered anywhere in Kenya.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href={url('/quote/')}>
              Request a Quote
              <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </a>
            <a class="link-reveal hero__link" href={url('/packages/')}>See the kits</a>
          </div>
        </div>
      </div>

      <div class="hero__aside">
        <figure class="plate hero__plate">
          <Sprig />
          <div class="plate__img">
            <img
              src={url('/images/placeholders/hero.svg')}
              alt="Placeholder: packed dignity kits ready for distribution"
              width="480"
              height="600"
              fetchpriority="high"
            />
          </div>
          <figcaption>
            <span class="label">Plate I</span>
            <span class="label">Kits ready for distribution</span>
          </figcaption>
        </figure>
        <dl class="ledger hero__ledger">
          <div><dt>Delivery</dt><dd>All 47 counties</dd></div>
          <div><dt>Orders</dt><dd>Bulk · priced by quote</dd></div>
          <div><dt>Custom</dt><dd>Built on request</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="serve" aria-labelledby="serve-title">
    <div class="container serve__inner">
      <h2 id="serve-title" class="serve__title label">Supplying</h2>
      <ul class="serve__list">
        {audiences.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- Statement -->
  <section class="section">
    <div class="container statement">
      <h2 class="statement__title">Reliable supply means girls stay in school and women go about their day with confidence.</h2>
      <div class="statement__body">
        <p>
          When a program can count on sanitary pads and basic hygiene items arriving on time, every month, the women and
          girls it serves can count on them too.
        </p>
        <p>
          Rosy's Essentials takes the sourcing, packing and delivery off your hands, so your team can focus on the people
          you serve. <a class="nowrap" href={url('/about/')}>Read our story</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Kits index -->
  <section class="section section--rule" aria-labelledby="packages-title">
    <div class="container">
      <div class="section-head">
        <h2 id="packages-title">Three <span class="nowrap">ready-made</span> kits, or one built for you</h2>
        <p class="muted">
          Every kit is sold in bulk with volume-based pricing. Choose a package and request a quote. We'll tailor it to
          your quantity and delivery location.
        </p>
      </div>
      <PackageCards />
    </div>
  </section>

  <DeliveryBanner />

  <!-- Why choose us -->
  <section class="section section--parchment" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head section-head--solo">
        <h2 id="why-title">A supplier your program can rely on</h2>
      </div>
      <WhyChooseUs />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 8vw, 6rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem; /* room for the sprig above the plate on phones */
  }

  .hero h1 {
    font-size: var(--step-display);
    margin: 0 0 clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero__plate {
    position: relative;
  }

  .hero__sub .lead {
    margin-bottom: 1.75rem;
  }

  .hero__link {
    font-weight: 600;
  }

  .hero__plate img {
    aspect-ratio: 4 / 5;
  }

  .hero__ledger {
    margin-top: 1.5rem;
  }

  .serve {
    border-block: 1px solid var(--hairline);
    padding-block: 1.1rem;
  }

  .serve__inner {
    display: grid;
    gap: 0.5rem;
  }

  .serve__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    line-height: 1.5;
  }

  .serve__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    line-height: 1.25;
  }

  .serve__list li {
    display: inline;
  }

  .serve__list li:not(:last-child)::after {
    content: ' / ';
    color: var(--rosehip);
  }

  /* Statement: big serif set off-centre, body text drops into the right-hand column */
  .statement {
    display: grid;
    gap: 2rem;
  }

  .statement__title {
    margin: 0;
    font-size: var(--step-h2);
    line-height: 1;
    letter-spacing: var(--display-track);
  }

  .statement__body {
    color: var(--ink-soft);
    font-size: 1.0625rem;
    max-width: var(--measure);
  }

  .section-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head p {
    margin: 0;
    max-width: var(--measure);
  }

  @media (min-width: 900px) {
    /* Asymmetric split: 7 columns of type, 5 of plate; the headline runs into the plate's margin */
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
      align-items: start;
    }

    .hero__copy {
      position: relative;
      z-index: 1;
      padding-top: clamp(1rem, 4vw, 3rem);
    }

    /* Clear room above the plate so the sprig never reaches the sticky header */
    .hero__aside {
      padding-top: 2.5rem;
    }

    /* Scale with the 7-column text area so the headline sets in three lines at every desktop width */
    .hero h1 {
      font-size: clamp(4rem, 7.2vw, 6.5rem);
      margin-right: -4rem;
    }

    .hero__sub {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      max-width: var(--measure);
    }

    .serve__inner {
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: baseline;
      gap: 2rem;
    }

    .statement {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .section-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .section-head--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
