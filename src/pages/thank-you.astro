---
// Shown after a quote request when JavaScript is off (Web3Forms redirects here).
// With JavaScript on, the success message appears on the quote page itself.
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout title="Thank You" description="Your quote request has been sent to Rosy's Essentials." noindex>
  <section class="section">
    <div class="container thanks">
      <svg viewBox="0 0 48 48" width="64" height="64" aria-hidden="true" focusable="false">
        <circle cx="24" cy="24" r="22" fill="var(--rose-50)" stroke="var(--rose-600)" stroke-width="2.5" />
        <path d="M14 25l7 7 13-15" fill="none" stroke="var(--rose-600)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h1>Thank you — your quote request has been sent</h1>
      <p class="lead">We've received your request and will be in touch soon with a tailored quote.</p>
      <p>Need to add something? Call us on <a href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a>.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={url('/packages/')}>Back to packages</a>
        <a class="btn btn--secondary" href={url('/')}>Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    max-width: 40rem;
    padding-block: 2rem;
  }

  .thanks svg {
    margin-bottom: 1.25rem;
  }
</style>
