---
// PLACEHOLDER logo — a line-drawn rosehip mark plus serif wordmark. Replace with the final logo when it is ready.
import { url } from '../utils/url';
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href={url('/')} class:list={['logo', { 'logo--inverse': inverse }]} aria-label="Rosy's Essentials home">
  <svg class="logo__mark" viewBox="0 0 32 40" width="26" height="32" aria-hidden="true" focusable="false">
    <!-- rosehip: the fruit, its sepal crown, stem and one leaf -->
    <path class="logo__hip" d="M16 13.5c5.2 0 8.5 4.2 8.5 9.3S21 32 16 32s-8.5-4.1-8.5-9.2S10.8 13.5 16 13.5z" />
    <path class="logo__line" d="M16 13.5V3M16 13.5l-5.5-5M16 13.5l5.5-5M16 13.5l-2.2-6.8M16 13.5l2.2-6.8M16 32v6" />
    <path class="logo__line" d="M16 36c-3.4 0-6-1.4-7.2-4 3.4 0 6 1.4 7.2 4z" />
  </svg>
  <span class="logo__text">Rosy's <span>Essentials</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }

  .logo__hip {
    fill: var(--rosehip);
  }

  .logo__line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Phones: the name stacks on two lines so the header fits; one line from tablet up */
  .logo__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    line-height: 0.92;
  }

  @media (min-width: 600px) {
    .logo__text {
      display: inline;
      font-size: 1.55rem;
    }
  }

  .logo--inverse {
    color: var(--on-dark);
  }

  .logo--inverse .logo__hip {
    fill: var(--on-dark);
  }
</style>
