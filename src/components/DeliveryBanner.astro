---
// "Delivery anywhere in Kenya" — used on Home and Packages. Sets every county we deliver to as a typeset block.
import { url } from '../utils/url';
import counties from '../data/counties.json';
---

<section class="delivery" aria-labelledby="delivery-title">
  <div class="container delivery__inner">
    <div class="delivery__head">
      <p class="delivery__count" aria-hidden="true">47</p>
      <div>
        <h2 id="delivery-title">Delivery anywhere in Kenya</h2>
        <p class="delivery__text">
          We deliver to all 47 counties: your office, a school, a health facility or a community distribution point.
          Tell us where and when, and we plan the delivery around your program.
        </p>
        <a class="btn btn--light" href={url('/quote/')}>
          Request a Quote
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </a>
      </div>
    </div>

    <ul class="delivery__counties" aria-label="The 47 counties we deliver to">
      {counties.map((county) => <li>{county}</li>)}
    </ul>
  </div>
</section>

<style>
  .delivery {
    background: var(--ink);
    color: var(--on-dark);
    padding-block: var(--space-section);
  }

  .delivery__inner {
    display: grid;
    gap: 3rem;
  }

  .delivery__head {
    display: grid;
    gap: 1rem;
  }

  .delivery__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(7rem, 30vw, 15rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--rosehip);
    /* the numeral sits on a lighter keyline so it reads on ink */
    -webkit-text-stroke: 1px var(--on-dark-soft);
  }

  .delivery h2 {
    max-width: 12ch;
  }

  .delivery__text {
    color: var(--on-dark-soft);
    max-width: 30rem;
    margin-bottom: 1.75rem;
  }

  /* All 47 county names as one dense typeset block, separated by hairline slashes */
  .delivery__counties {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--hairline-dark);
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    text-transform: uppercase;
    line-height: 2.1;
    color: var(--on-dark);
  }

  .delivery__counties li {
    display: inline;
  }

  .delivery__counties li:not(:last-child)::after {
    content: ' / ';
    color: var(--on-dark-soft);
    opacity: 0.55;
  }

  @media (min-width: 900px) {
    .delivery__inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 4rem;
      align-items: end;
    }

    .delivery__head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }

    .delivery__counties {
      padding: 0 0 0 2.5rem;
      border-top: 0;
      border-left: 1px solid var(--hairline-dark);
      font-size: 0.8125rem;
      line-height: 2.2;
    }
  }
</style>
