---
// Numbered kit index for the Home page: Basic, Essential, Premium + Custom Kit.
// All content comes from src/data/packages.json.
// Desktop: hovering or focusing a row shows that kit's plate in the preview column (CSS only, no JavaScript).
// Phones: each row carries its own small plate, since there is no hover.
import { url } from '../utils/url';
import packages from '../data/packages.json';

const tiers = packages.tiers.map((tier) => ({
  ...tier,
  manifest: packages.items
    .map((item) => ({ label: item.label, short: item.short, value: tier.contents[item.key as keyof typeof tier.contents] }))
    .filter((line) => line.value),
}));
const custom = packages.custom;
const popular = tiers.find((t) => t.popular) ?? tiers[0];
---

<div class="kits">
  <ol class="kits__list">
    {tiers.map((tier, i) => (
      <li class:list={['kit', `kit--${tier.id}`]}>
        <article aria-labelledby={`kit-${tier.id}`}>
          <p class="kit__num label" aria-hidden="true">0{i + 1}</p>
          <div class="kit__thumb plate__img">
            <img src={url(tier.image)} alt="" width="480" height="600" loading="lazy" decoding="async" />
          </div>
          <div class="kit__head">
            <h3 id={`kit-${tier.id}`}>{tier.name}</h3>
            {tier.popular && <p class="kit__tag label">Most popular</p>}
            <p class="kit__best">Best for {tier.bestFor.toLowerCase()}</p>
          </div>
          <ul class="kit__manifest label" aria-label={`What's inside the ${tier.name} kit`}>
            {tier.manifest.map((line) => (
              <li><span class="visually-hidden">{line.label}: </span>{line.short && <span aria-hidden="true">{line.short} </span>}{line.value}</li>
            ))}
          </ul>
          <div class="kit__actions">
            <a class="btn btn--primary" href={url(`/quote/?package=${tier.id}`)}>
              Request a Quote<span class="visually-hidden"> for the {tier.name} kit</span>
            </a>
            <a class="link-reveal kit__more" href={url(`/packages/#${tier.id}`)}>
              Full details<span class="visually-hidden"> of the {tier.name} kit</span>
            </a>
          </div>
        </article>
      </li>
    ))}

    <li class="kit kit--custom">
      <article aria-labelledby="kit-custom">
        <p class="kit__num label" aria-hidden="true">0{tiers.length + 1}</p>
        <div class="kit__thumb plate__img">
          <img src={url(custom.image)} alt="" width="480" height="600" loading="lazy" decoding="async" />
        </div>
        <div class="kit__head">
          <h3 id="kit-custom">{custom.name}</h3>
          <p class="kit__best">{custom.summary}</p>
        </div>
        <ul class="kit__manifest label">
          {custom.points.map((point) => <li>{point}</li>)}
        </ul>
        <div class="kit__actions">
          <a class="btn btn--outline" href={url('/quote/?package=custom')}>Request a Custom Kit</a>
        </div>
      </article>
    </li>
  </ol>

  <!-- Desktop preview column: one plate per kit, the hovered or focused row's plate shows -->
  <div class="kits__preview" aria-hidden="true">
    <div class="plate">
      <div class="plate__img kits__stage">
        {tiers.map((tier) => (
          <img class:list={['kits__img', `kits__img--${tier.id}`, { 'is-default': tier.id === popular.id }]} src={url(tier.image)} alt="" width="480" height="600" loading="lazy" decoding="async" />
        ))}
        <img class="kits__img kits__img--custom" src={url(custom.image)} alt="" width="480" height="600" loading="lazy" decoding="async" />
      </div>
      <p class="label kits__caption">Placeholder plates · photos to come</p>
    </div>
  </div>
</div>

<style>
  .kits__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .kit {
    border-bottom: 1px solid var(--hairline);
  }

  .kit article {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 5.5rem;
    grid-template-areas:
      'num head thumb'
      'num manifest manifest'
      'num actions actions';
    gap: 0.75rem 0.75rem;
    padding-block: 1.75rem;
  }

  .kit__num {
    grid-area: num;
    margin: 0;
    padding-top: 0.55rem;
  }

  .kit__thumb {
    grid-area: thumb;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hairline);
  }

  .kit__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kit__head {
    grid-area: head;
  }

  .kit__head h3 {
    display: inline;
    margin: 0;
    font-size: clamp(2.5rem, 9vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: var(--display-track);
  }

  .kit__tag {
    display: inline-block;
    margin: 0 0 0 0.6rem;
    vertical-align: 0.9em;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rosehip);
    color: var(--rosehip);
  }

  .kit__best {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }

  .kit__manifest {
    grid-area: manifest;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--ink);
  }

  /* Each item wraps as a unit where it can, and only breaks inside when it is longer than the line */
  .kit__manifest li {
    display: inline-block;
    max-width: 100%;
  }

  .kit__manifest li:not(:last-child)::after {
    content: '  ·  ';
    white-space: pre;
    color: var(--ink-soft);
  }

  .kit__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }

  .kit__more {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .kits__preview {
    display: none;
  }

  @media (min-width: 1024px) {
    .kits {
      display: grid;
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 3.5rem;
      align-items: start;
    }

    .kit article {
      grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas:
        'num head manifest'
        'num head actions';
      gap: 0.5rem 2.5rem;
      padding-block: 2.25rem;
    }

    .kit__thumb {
      display: none;
    }

    .kit__manifest {
      padding-top: 0.6rem;
    }

    .kit__actions {
      align-self: end;
    }

    .kit {
      transition: background-color var(--dur-fast) var(--ease);
    }

    .kit:hover,
    .kit:focus-within {
      background: var(--parchment);
    }

    .kit:hover .kit__head h3,
    .kit:focus-within .kit__head h3 {
      font-style: italic;
    }

    /* Preview column stays in view while the list scrolls */
    .kits__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .kits__stage {
      position: relative;
      aspect-ratio: 4 / 5;
    }

    .kits__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      transform: scale(1.03);
      transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
    }

    .kits__img.is-default {
      opacity: 1;
      transform: none;
    }

    .kits__caption {
      margin: 0.65rem 0 0;
    }

    /* While any row is hovered or focused, show that row's plate instead of the default */
    .kits:has(.kit:hover, .kit:focus-within) .kits__img.is-default {
      opacity: 0;
    }

    .kits:has(.kit--basic:hover, .kit--basic:focus-within) .kits__img--basic,
    .kits:has(.kit--essential:hover, .kit--essential:focus-within) .kits__img--essential,
    .kits:has(.kit--premium:hover, .kit--premium:focus-within) .kits__img--premium,
    .kits:has(.kit--custom:hover, .kit--custom:focus-within) .kits__img--custom {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kits__img {
      transform: none !important;
    }
  }
</style>
