---
import { url } from '../utils/url';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to plan your next distribution?',
  text = 'Tell us the package, quantity and delivery location. We’ll reply with a tailored quote for your program.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <h2 id="cta-title">{title}</h2>
    <div class="cta__side">
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn--light" href={url('/quote/')}>
          Request a Quote
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </a>
        <a class="link-reveal cta__secondary" href={url('/packages/')}>Compare packages</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--rosehip);
    color: var(--on-dark);
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .cta__inner {
    display: grid;
    gap: 1.75rem;
  }

  .cta h2 {
    margin: 0;
    font-size: var(--step-h1);
    line-height: var(--display-leading);
    letter-spacing: var(--display-track);
  }

  .cta p {
    color: var(--on-rosehip-soft);
    font-size: 1.1rem;
    max-width: var(--measure);
    margin-bottom: 1.75rem;
  }

  .cta__secondary {
    color: var(--on-dark);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }
</style>
