---
import { url } from '../utils/url';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to plan your next distribution?',
  text = 'Tell us the package, quantity and delivery location. We’ll reply with a tailored quote for your program.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <svg class="cta__petal" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <path d="M100 10c50 0 90 40 90 90-50 0-90-40-90-90zM100 190c-50 0-90-40-90-90 50 0 90 40 90 90z" fill="currentColor" />
  </svg>
  <div class="container cta__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn cta__primary" href={url('/quote/')}>Request a Quote</a>
      <a class="btn cta__secondary" href={url('/packages/')}>Compare packages</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--plum-900) 0%, var(--rose-700) 100%);
    color: var(--white);
    padding-block: 3.5rem;
  }

  .cta__petal {
    position: absolute;
    right: -2rem;
    bottom: -3rem;
    width: 14rem;
    height: 14rem;
    color: var(--white);
    opacity: 0.07;
    transform: rotate(-15deg);
  }

  .cta h2 {
    color: var(--white);
  }

  .cta p {
    color: #fbe9ee;
    max-width: 38rem;
  }

  .cta__inner {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .cta__primary {
    background: var(--white);
    color: var(--rose-700);
  }

  .cta__primary:hover {
    background: var(--rose-50);
    color: var(--rose-700);
  }

  .cta__secondary {
    border-color: var(--white);
    color: var(--white);
  }

  .cta__secondary:hover {
    background: rgb(255 255 255 / 12%);
    color: var(--white);
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }

    .cta p {
      margin: 0;
    }
  }
</style>
