---
import { url } from '../utils/url';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to plan your next distribution?',
  text = 'Tell us the package, quantity and delivery location. We’ll reply with a tailored quote for your program.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn cta__primary" href={url('/quote/')}>Request a Quote</a>
      <a class="btn cta__secondary" href={url('/packages/')}>Compare packages</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--rose-700);
    color: var(--white);
    padding-block: 3rem;
  }

  .cta h2 {
    color: var(--white);
  }

  .cta p {
    color: #fbe9ee;
    max-width: 38rem;
  }

  .cta__inner {
    display: grid;
    gap: 1.25rem;
  }

  .cta__primary {
    background: var(--white);
    color: var(--rose-700);
  }

  .cta__primary:hover {
    background: var(--rose-50);
    color: var(--rose-700);
  }

  .cta__secondary {
    border-color: var(--white);
    color: var(--white);
  }

  .cta__secondary:hover {
    background: rgb(255 255 255 / 12%);
    color: var(--white);
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3rem;
    }

    .cta p {
      margin: 0;
    }
  }
</style>
