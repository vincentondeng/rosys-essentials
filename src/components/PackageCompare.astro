---
// Side-by-side comparison of the three tiers. All content comes from src/data/packages.json.
import { url } from '../utils/url';
import packages from '../data/packages.json';

const { items, tiers } = packages;
---

<div class="compare" role="region" aria-labelledby="compare-caption" tabindex="0">
  <table>
    <caption id="compare-caption" class="visually-hidden">What's inside each kit</caption>
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Item</span></th>
        {tiers.map((tier, i) => (
          <th scope="col" class:list={{ popular: tier.popular }}>
            <span class="compare__num" aria-hidden="true">0{i + 1}</span>
            <span class="compare__name">{tier.name}</span>
            {tier.popular && <span class="compare__badge">Most popular</span>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <th scope="row">{item.label}</th>
          {tiers.map((tier) => {
            const value = tier.contents[item.key as keyof typeof tier.contents];
            return (
              <td class:list={{ popular: tier.popular }}>
                {value ? value : <><span class="compare__none" aria-hidden="true">–</span><span class="visually-hidden">Not included</span></>}
              </td>
            );
          })}
        </tr>
      ))}
      <tr>
        <th scope="row">Best for</th>
        {tiers.map((tier) => (
          <td class:list={['compare__best', { popular: tier.popular }]}>{tier.bestFor}</td>
        ))}
      </tr>
      <tr>
        <th scope="row">Minimum order</th>
        {tiers.map((tier) => <td class:list={{ popular: tier.popular }}>{tier.minOrder}</td>)}
      </tr>
    </tbody>
    <tfoot class="compare__actions">
      <tr>
        <td></td>
        {tiers.map((tier) => (
          <td class:list={{ popular: tier.popular }}>
            <a class="btn btn--primary" href={url(`/quote/?package=${tier.id}`)}>
              Request a Quote<span class="visually-hidden"> for the {tier.name} kit</span>
            </a>
          </td>
        ))}
      </tr>
    </tfoot>
  </table>
</div>

<style>
  .compare {
    overflow-x: auto;
    border-top: 1px solid var(--ink);
  }

  /* Phones: compact enough for all three kits side by side at 360px+; scrolls sideways below that */
  table {
    width: 100%;
    min-width: 300px;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.8rem;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  th,
  td {
    padding: 0.7rem 0.3rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hairline);
  }

  tbody th {
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--ink-soft);
    width: 23%;
    padding-left: 0;
    font-size: 0.75rem;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  thead th {
    padding-block: 1.25rem 1rem;
    vertical-align: bottom;
    font-weight: 400;
  }

  .compare__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .compare__name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.5vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .compare__badge {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--rosehip);
    color: var(--rosehip);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Most popular column: a parchment band with a rosehip rule on top */
  .popular {
    background: var(--parchment);
  }

  thead th.popular {
    box-shadow: inset 0 2px 0 var(--rosehip);
  }

  td.popular {
    font-weight: 600;
  }

  .compare__none {
    color: var(--ink-soft);
  }

  .compare__best {
    font-size: 0.8rem;
  }

  /* On phones the detail sections below carry the quote buttons */
  .compare__actions {
    display: none;
  }

  @media (min-width: 768px) {
    table {
      font-size: 1rem;
    }

    th,
    td {
      padding: 1rem 1.25rem;
    }

    tbody th {
      font-size: var(--mono-size);
      padding-left: 0;
    }

    .compare__best {
      font-size: 0.95rem;
    }

    .compare__actions {
      display: table-footer-group;
    }

    .compare__actions td {
      border-bottom: 0;
      padding-top: 1.5rem;
    }
  }
</style>
