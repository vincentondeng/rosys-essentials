---
// Side-by-side comparison of the three tiers. All content comes from src/data/packages.json.
import packages from '../data/packages.json';

const { items, tiers } = packages;
---

<div class="compare" role="region" aria-labelledby="compare-caption" tabindex="0">
  <table>
    <caption id="compare-caption" class="visually-hidden">What's inside each kit</caption>
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Item</span></th>
        {tiers.map((tier) => (
          <th scope="col" class:list={{ popular: tier.popular }}>
            {tier.popular && <span class="compare__badge">Most popular</span>}
            <span class="compare__name">{tier.name}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {items.map((item) => (
        <tr>
          <th scope="row">{item.label}</th>
          {tiers.map((tier) => {
            const value = tier.contents[item.key as keyof typeof tier.contents];
            return (
              <td class:list={{ popular: tier.popular }}>
                {value ? value : <><span class="compare__none" aria-hidden="true">—</span><span class="visually-hidden">Not included</span></>}
              </td>
            );
          })}
        </tr>
      ))}
      <tr>
        <th scope="row">Best for</th>
        {tiers.map((tier) => (
          <td class:list={['compare__best', { popular: tier.popular }]}>{tier.bestFor}</td>
        ))}
      </tr>
      <tr>
        <th scope="row">Minimum order</th>
        {tiers.map((tier) => <td class:list={{ popular: tier.popular }}>{tier.minOrder}</td>)}
      </tr>
    </tbody>
    <tfoot class="compare__actions">
      <tr>
        <td></td>
        {tiers.map((tier) => (
          <td class:list={{ popular: tier.popular }}>
            <a class="btn btn--primary" href={`/quote/?package=${tier.id}`}>
              Request a Quote<span class="visually-hidden"> for the {tier.name} kit</span>
            </a>
          </td>
        ))}
      </tr>
    </tfoot>
  </table>
</div>

<style>
  .compare {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  /* Phones: compact enough for all three kits to fit side by side at 360px+; scrolls sideways below that */
  table {
    width: 100%;
    min-width: 310px;
    border-collapse: collapse;
    font-size: 0.8rem;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  th,
  td {
    padding: 0.6rem 0.3rem;
    text-align: center;
    vertical-align: middle;
    border-bottom: 1px solid var(--line);
  }

  tbody th {
    text-align: left;
    font-weight: 600;
    color: var(--plum-700);
    width: 25%;
    padding-left: 0.65rem;
  }

  thead th {
    padding-top: 1.1rem;
    vertical-align: bottom;
  }

  .compare__name {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--plum-900);
  }

  .compare__badge {
    display: inline-block;
    margin-bottom: 0.35rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--rose-600);
    color: var(--white);
    font-size: 0.65rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .popular {
    background: var(--rose-50);
  }

  td.popular {
    font-weight: 600;
  }

  .compare__none {
    color: #9a8794;
  }

  .compare__best {
    font-size: 0.75rem;
  }

  /* On phones the detail sections below carry the quote buttons */
  .compare__actions {
    display: none;
  }

  .compare__actions td {
    border-bottom: 0;
    padding-block: 1.1rem;
  }

  @media (min-width: 720px) {
    table {
      font-size: 1rem;
    }

    th,
    td {
      padding: 0.9rem 1.1rem;
    }

    tbody th {
      padding-left: 1.25rem;
    }

    .compare__badge {
      padding: 0.15rem 0.55rem;
      font-size: 0.75rem;
    }

    .compare__name {
      font-size: 1.2rem;
    }

    .compare__best {
      font-size: 0.95rem;
    }

    .compare__actions {
      display: table-footer-group;
    }
  }
</style>
