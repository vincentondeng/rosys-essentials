---
// "Why choose us" as a bento grid ruled with 1px lines. The first point carries the most weight.
const points = [
  {
    title: 'Ready-packed kits',
    text: 'Every kit arrives assembled and ready to hand out, saving your team procurement and packing time.',
  },
  {
    title: 'Bulk pricing, flexible sizes',
    text: 'Volume-based pricing for large programs, and order sizes that fit smaller budgets too.',
  },
  {
    title: 'Quality, trusted products',
    text: 'We source products women already know and trust, so every kit is something worth receiving.',
  },
  {
    title: 'Reliable delivery, anywhere in Kenya',
    text: 'From Nairobi to the most remote county, we deliver to your office, school or distribution point.',
  },
  {
    title: 'Custom kits for programs and donors',
    text: 'Choose the contents, quantities and branding to match your program or a donor’s requirements.',
  },
];
---

<ul class="why">
  {points.map((point, i) => (
    <li class:list={['why__cell', { 'why__cell--lead': i === 0 }]}>
      <h3 class="why__title">{point.title}</h3>
      <p class="why__text">{point.text}</p>
    </li>
  ))}
</ul>

<style>
  /* The grid's 1px gaps show the ink-tinted background through: crisp ruled lines, no borders to double up */
  .why {
    list-style: none;
    margin: 0;
    padding: 1px;
    display: grid;
    gap: 1px;
    background: var(--hairline);
  }

  .why__cell {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--parchment);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .why__title {
    margin: 0;
  }

  .why__text {
    margin: 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .why__cell--lead {
    background: var(--linen);
  }

  .why__cell--lead .why__title {
    font-size: var(--step-h2);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  @media (min-width: 700px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .why__cell--lead {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .why {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .why__cell {
      min-height: 15rem;
    }

    .why__cell--lead {
      grid-column: span 2;
    }
  }
</style>
