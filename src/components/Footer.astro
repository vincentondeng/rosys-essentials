---
import { url } from '../utils/url';
import Logo from './Logo.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__statement">Delivering across Kenya, <em>all 47 counties.</em></p>

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo inverse />
        <p>Ready-packed dignity kits for NGOs, schools, faith-based groups and community organizations.</p>
      </div>

      <div>
        <h2 class="site-footer__heading">Pages</h2>
        <ul class="site-footer__list">
          <li><a class="link-reveal" href={url('/')}>Home</a></li>
          <li><a class="link-reveal" href={url('/packages/')}>Packages</a></li>
          <li><a class="link-reveal" href={url('/how-it-works/')}>How It Works</a></li>
          <li><a class="link-reveal" href={url('/about/')}>About Us</a></li>
          <li><a class="link-reveal" href={url('/quote/')}>Request a Quote</a></li>
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Contact</h2>
        <dl class="site-footer__contact">
          <div><dt>Phone</dt><dd><a class="link-reveal" href={`tel:${site.phoneLink}`}>{site.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a class="link-reveal" href={`mailto:${site.emailLink}`}>{site.email}</a></dd></div>
          <div><dt>Office</dt><dd>{site.address}</dd></div>
          <div><dt>Hours</dt><dd>{site.hours}</dd></div>
        </dl>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {site.name}</p>
      <p>Quote-only pricing · Bulk orders · Custom kits</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-soft);
    padding-block: clamp(3.5rem, 9vw, 6rem) 6rem; /* extra bottom space so the WhatsApp button never covers text */
    font-size: 0.95rem;
  }

  .site-footer a {
    color: var(--on-dark);
  }

  .site-footer__statement {
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--hairline-dark);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: var(--display-track);
    color: var(--on-dark);
    text-wrap: balance;
  }

  .site-footer__statement em {
    font-style: italic;
    color: var(--on-dark-soft);
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__brand p {
    margin-top: 1rem;
    max-width: 26rem;
  }

  .site-footer__heading {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    font-weight: 500;
    letter-spacing: var(--mono-track);
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__contact {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .site-footer__contact div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .site-footer__contact dt {
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    text-transform: uppercase;
    padding-top: 0.2em;
  }

  .site-footer__contact dd {
    margin: 0;
    color: var(--on-dark);
    overflow-wrap: anywhere;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline-dark);
    font-family: var(--font-mono);
    font-size: var(--mono-size);
    letter-spacing: var(--mono-track);
    text-transform: uppercase;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.6fr;
      gap: 3rem;
    }
  }
</style>
