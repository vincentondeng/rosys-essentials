---
// Decorative pressed rosehip sprig (ink stem, ochre leaves, rosehip fruit).
// Pinned over a corner of its nearest positioned ancestor, e.g. a plate.
// It sits mostly above the frame (only the stem tip crosses onto the photo),
// and a thin linen outline keeps it crisp over dark, busy or warm-toned photos.
interface Props {
  corner?: 'top-right' | 'top-left'; // choose the corner the plate's label doesn't use
}
const { corner = 'top-right' } = Astro.props;

const leaves = [
  'M57 112C40 110 30 100 25 89c15 1 27 9 32 23z',
  'M59 108c12-9 24-11 33-8-7 10-20 13-33 8z',
  'M50 73c11-8 22-9 31-5-8 9-20 11-31 5z',
  'M44 58c-13-3-21-12-24-22 13 2 22 10 24 22z',
];
const stems = [
  'M60 136C58 104 50 70 31 36M56 96c12-20 26-38 37-58',
  'M31 12l-3-8M31 12l4-7M31 12l-7-4M98 15l1-8M98 15l5-6M98 15l-6-5',
];
const hips = [
  'M31 36c-6 0-10-6-9-13s7-13 12-12 8 8 6 15-4 10-9 10z',
  'M94 38c-5-1-8-7-6-14s8-11 12-9 6 9 3 15-5 9-9 8z',
];
const all = [...leaves, ...stems, ...hips];
---

<svg class:list={['sprig', `sprig--${corner}`]} viewBox="-4 -4 128 148" aria-hidden="true" focusable="false">
  <g class="sprig__halo">{all.map((d) => <path d={d} />)}</g>
  {leaves.map((d) => <path class="sprig__leaf" d={d} />)}
  {stems.map((d) => <path class="sprig__stem" d={d} />)}
  {hips.map((d) => <path class="sprig__hip" d={d} />)}
</svg>

<style>
  .sprig {
    --sprig-w: clamp(4.5rem, 12vw, 7rem);
    position: absolute;
    z-index: 1;
    /* Lift the sprig so all but the stem tip sits above the frame */
    top: calc(var(--sprig-w) * -1.16 + 2.25rem);
    width: var(--sprig-w);
    height: auto;
    pointer-events: none;
  }

  .sprig--top-right {
    right: clamp(-0.5rem, 1vw, 1rem);
    transform: rotate(14deg);
  }

  /* Mirrored so the stem still runs off the plate's outer edge */
  .sprig--top-left {
    left: clamp(-0.5rem, 1vw, 1rem);
    transform: scaleX(-1) rotate(14deg);
  }

  /* Linen outline drawn under the sprig, like a cut-out */
  .sprig__halo path {
    fill: none;
    stroke: var(--linen);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sprig__stem {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .sprig__leaf {
    fill: var(--ochre);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .sprig__hip {
    fill: var(--rosehip);
    stroke: var(--ink);
    stroke-width: 1.1;
  }
</style>
