---
// Decorative pressed rosehip sprig (ink stem, ochre leaves, rosehip fruit).
// Pinned over a corner of its nearest positioned ancestor, e.g. a plate.
interface Props {
  corner?: 'top-right' | 'top-left'; // choose the corner the plate's label doesn't use
}
const { corner = 'top-right' } = Astro.props;
---

<svg class:list={['sprig', `sprig--${corner}`]} viewBox="0 0 120 140" aria-hidden="true" focusable="false">
  <path class="sprig__leaf" d="M57 112C40 110 30 100 25 89c15 1 27 9 32 23z" />
  <path class="sprig__leaf" d="M59 108c12-9 24-11 33-8-7 10-20 13-33 8z" />
  <path class="sprig__leaf" d="M50 73c11-8 22-9 31-5-8 9-20 11-31 5z" />
  <path class="sprig__leaf" d="M44 58c-13-3-21-12-24-22 13 2 22 10 24 22z" />
  <path class="sprig__stem" d="M60 136C58 104 50 70 31 36M56 96c12-20 26-38 37-58" />
  <path class="sprig__hip" d="M31 36c-6 0-10-6-9-13s7-13 12-12 8 8 6 15-4 10-9 10z" />
  <path class="sprig__hip" d="M94 38c-5-1-8-7-6-14s8-11 12-9 6 9 3 15-5 9-9 8z" />
  <path class="sprig__stem" d="M31 12l-3-8M31 12l4-7M31 12l-7-4M98 15l1-8M98 15l5-6M98 15l-6-5" />
</svg>

<style>
  .sprig {
    position: absolute;
    z-index: 1;
    top: clamp(-2.25rem, -4vw, -1.25rem);
    width: clamp(4.5rem, 12vw, 7rem);
    height: auto;
    pointer-events: none;
  }

  .sprig--top-right {
    right: clamp(-0.5rem, 1vw, 1rem);
    transform: rotate(14deg);
  }

  /* Mirrored so the stem still runs off the plate's outer edge */
  .sprig--top-left {
    left: clamp(-0.5rem, 1vw, 1rem);
    transform: scaleX(-1) rotate(14deg);
  }

  .sprig__stem {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .sprig__leaf {
    fill: var(--ochre);
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .sprig__hip {
    fill: var(--rosehip);
    stroke: var(--ink);
    stroke-width: 1.1;
  }
</style>
