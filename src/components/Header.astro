---
import { url } from '../utils/url';
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/packages/', label: 'Packages' },
  { href: '/how-it-works/', label: 'How It Works' },
  { href: '/about/', label: 'About Us' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />

    <nav class="nav nav--desktop" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a class="link-reveal" href={url(link.href)} aria-current={current === url(link.href) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={url('/quote/')} class="btn btn--primary site-header__cta">Request a Quote</a>

    <!-- Mobile menu: <details> opens and closes without any JavaScript. -->
    <details class="nav-mobile">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path class="icon-open" d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.5" />
          <path class="icon-close" d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="nav-mobile__label">Menu</span>
      </summary>
      <nav class="nav-mobile__panel" aria-label="Main (mobile)">
        <ol>
          {links.map((link, i) => (
            <li>
              <a href={url(link.href)} aria-current={current === url(link.href) ? 'page' : undefined}>
                <span class="label" aria-hidden="true">0{i + 1}</span>
                {link.label}
              </a>
            </li>
          ))}
        </ol>
        <a href={url('/quote/')} class="btn btn--primary btn--block">Request a Quote</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--linen);
    border-bottom: 1px solid var(--hairline);
    container: header / inline-size;
    overflow-x: clip;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--header-h);
  }

  .site-header__inner > :global(.logo) {
    margin-right: auto;
  }

  .site-header__cta {
    min-height: 40px;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .nav ul,
  .nav-mobile__panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .nav a[aria-current='page'] {
    color: var(--rosehip);
  }

  .nav--desktop {
    display: none;
  }

  /* Mobile menu */
  .nav-mobile summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--ink);
    cursor: pointer;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .icon-close,
  .nav-mobile[open] .icon-open {
    display: none;
  }

  .nav-mobile[open] .icon-close {
    display: inline;
  }

  .nav-mobile__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--linen);
    border-bottom: 1px solid var(--hairline);
  }

  /* Menu reads like a table of contents: mono number, serif title */
  .nav-mobile__panel li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-mobile__panel a[aria-current='page'] {
    color: var(--rosehip);
  }

  .nav-mobile__panel .btn {
    margin-top: 1.25rem;
  }

  /* Hide the header CTA when it no longer fits beside the logo and menu, measured in em so
     it also collapses when the visitor enlarges text. The CTA stays in the menu panel. */
  @container header (max-width: 21.5em) {
    .site-header__cta {
      display: none;
    }
  }

  @media (min-width: 960px) {
    .nav-mobile {
      display: none;
    }

    .nav--desktop {
      display: block;
    }

    .nav--desktop ul {
      display: flex;
      gap: 2rem;
    }

    .site-header__inner {
      gap: 2.5rem;
    }

    .site-header__cta {
      min-height: 44px;
      padding: 0.65rem 1.2rem;
      font-size: 0.9rem;
    }
  }
</style>
